---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CTABand from '../components/CTABand.astro';

const awards = [
  { title: "Dean's List", detail: 'Doctoral dissertation (top 10%), TUM 2020-2024' },
  { title: "Nature Communications Engineering Editor's Choice 2023", detail: 'For GaNDLF framework', link: 'https://www.nature.com/articles/s44172-023-00151-7#Sec4' },
  { title: 'Nature Communications Top 25 Health Sciences Articles 2022', detail: 'Federated Learning paper' },
  { title: 'Plenary Presentation (top 8%)', detail: 'Pendergrass Symposium 2023, for the Comprehensive Federated Ecosystem (COFE)' },
  { title: 'Best Poster Award (top 5%)', detail: 'NIH ITCR annual scientific meeting, 2020 and 2022' },
  { title: 'Oral Presentation (top 5%)', detail: 'Pendergrass Symposium: Federated Tumor Segmentation (2021), breast density estimation from tomosynthesis (2022)' },
  { title: 'Magna cum Laude (top 10%)', detail: 'Pendergrass Symposium 2021, for the Generally Nuanced Deep Learning Framework' },
  { title: '2nd Place', detail: 'Automatic Non-Rigid Histological Image Registration Challenge 2019' },
  { title: '1st Place', detail: 'Brain Tumor Segmentation Challenge at MICCAI 2015' },
];

const media = [
  { name: 'Wall Street Journal', desc: 'Intel and health institutions adopting federated learning to improve tumor detection', url: 'https://www.wsj.com/articles/intel-health-institutions-to-use-emerging-ai-technique-to-improve-tumor-detection-11589191200' },
  { name: 'EurekAlert', desc: 'The largest brain tumor study to date, run without sharing a single patient scan', url: 'https://www.eurekalert.org/news-releases/972921' },
  { name: 'News Medical', desc: 'Why federated learning lets you ask medical questions across institutions', url: 'https://www.news-medical.net/news/20200728/Federated-learning-approach-can-help-answer-different-medical-questions.aspx' },
  { name: 'IU News', desc: 'IU-led study using AI to predict breast cancer risk while addressing health disparities', url: 'https://news.iu.edu/live/news/37787-iu-led-study-uses-ai-to-predict-breast-cancer-risk' },
  { name: 'Science Daily', desc: 'The same federated brain tumor study, written up for a general audience', url: 'https://www.sciencedaily.com/releases/2022/12/221205104205.htm' },
];
---

<Base title="Accolades" description="Awards, recognition, and media mentions.">
  <section class="relative py-24 border-b border-ink/10 bg-paper">
    <div class="max-w-5xl mx-auto px-6">
      <Eyebrow num="01" label="Accolades" class="mb-3" />
      <span class="ghost-num text-[9rem] right-0 top-[-2rem]" aria-hidden="true">01</span>
      <h1 class="h-display text-4xl md:text-5xl text-ink mb-6 md:pr-48 reveal">Awards & recognition</h1>
      <p class="text-ink-soft max-w-xl leading-relaxed reveal reveal-2">
        Nearly all of these belong as much to the people I worked with as they do to me.
      </p>
    </div>
  </section>

  {/* Awards */}
  <section class="py-20 bg-paper border-b border-ink/10">
    <div class="max-w-5xl mx-auto px-6">
      <ul class="space-y-0">
        {awards.map((a) => (
          <li class="pb-7 border-b border-ink/10 last:border-b-0 group">
            <strong class="text-ink block">{a.title}</strong>
            {a.link ? (
              <a href={a.link} target="_blank" rel="noopener" class="text-sm text-ink-soft hover:text-saffron transition-colors link-ink mt-1 inline-block">
                {a.detail} →
              </a>
            ) : (
              <p class="text-sm text-ink-soft">{a.detail}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Media */}
  <section class="py-20 bg-cream border-b border-ink/10">
    <div class="max-w-5xl mx-auto px-6">
      <Eyebrow num="02" label="Media" class="mb-8" />
      <h2 class="font-display text-2xl font-semibold text-ink mb-8">Press coverage</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {media.map((m) => (
          <a href={m.url} target="_blank" rel="noopener" class="group block border-t-2 border-ink/80 pt-5 hover:border-saffron transition-colors duration-200">
            <h3 class="font-display text-lg font-semibold text-ink group-hover:text-saffron transition-colors">{m.name}</h3>
            <p class="text-sm text-ink-soft mt-1">{m.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    heading="Writing about any of this?"
    sub="Happy to answer questions, and to point you at the collaborators who did the other half of the work."
  />
</Base>
