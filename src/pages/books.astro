---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CTABand from '../components/CTABand.astro';
---

<Base title="Books" description="Selected readings and references.">
  <section class="relative py-24 border-b border-ink/10 bg-paper">
    <div class="max-w-5xl mx-auto px-6">
      <Eyebrow num="01" label="Books" class="mb-3" />
      <span class="ghost-num text-[9rem] right-0 top-[-2rem]" aria-hidden="true">01</span>
      <h1 class="h-display text-4xl md:text-5xl text-ink mb-6 md:pr-48 reveal">Books & references</h1>
      <p class="text-ink-soft max-w-xl leading-relaxed reveal reveal-2">
        Books that have shaped how I think. I'm still writing this page.
      </p>
    </div>
  </section>

  <section class="py-24 bg-paper border-b border-ink/10">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-ink-soft italic">Nothing here yet. I'm deciding what makes the cut.</p>
    </div>
  </section>

  <CTABand
    heading="Read something I should?"
    sub="Send it over. That is genuinely how this page is going to get written."
  />
</Base>
