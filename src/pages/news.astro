---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CTABand from '../components/CTABand.astro';

// Recent news items, update manually for now
const news = [
  {
    date: '2026-01-27',
    title: 'BraTS-MEN-RT dataset is out',
    body: 'The 2024 BraTS-MEN-RT dataset is published in Scientific Data: 570 radiotherapy planning MRIs, 3D T1-weighted and post-contrast, with 500 gross tumor volumes annotated by experts.',
    link: '#',
  },
  {
    date: '2025-07-26',
    title: 'Running models where the compute is not',
    body: 'Out in Computers in Biology and Medicine. What it actually takes to get these models inside a real latency and memory budget, tested across radiology, histopathology, and medical RGB imaging.',
    link: '#',
  },
  {
    date: '2025-06-25',
    title: 'Catching bad brain extractions without labels',
    body: 'Out in the Journal of Imaging Informatics in Medicine. Brain extraction fails quietly, so this method does the checking on its own: 0.9 accuracy on pre-op scans, 0.87 on post-op.',
    link: '#',
  },
  {
    date: '2025-02-15',
    title: 'Alzheimer\'s prediction that survives a scanner upgrade',
    body: 'Out in NeuroImage. MRI acquisition keeps changing underneath you. Transfer learning took diagnosis accuracy from 63% to 99% in the first of the scenarios we tested.',
    link: '#',
  },
];

// Parse as a local date; `new Date('2026-01-27')` is UTC midnight and renders a day early west of GMT.
const formatDate = (d: string) => {
  const [y, m, day] = d.split('-').map(Number);
  return new Date(y, m - 1, day).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<Base title="News" description="Recent announcements and updates.">
  <section class="relative py-24 border-b border-ink/10 bg-paper">
    <div class="max-w-5xl mx-auto px-6">
      <Eyebrow num="01" label="News" class="mb-3" />
      <span class="ghost-num text-[9rem] right-0 top-[-2rem]" aria-hidden="true">01</span>
      <h1 class="h-display text-4xl md:text-5xl text-ink mb-6 md:pr-48 reveal">News</h1>
      <p class="text-ink-soft max-w-xl leading-relaxed reveal reveal-2">
        Mostly papers and datasets. I update this when something actually ships, so the gaps are real.
      </p>
    </div>
  </section>

  {news.map((item) => (
    <article class="py-16 border-b border-ink/10 bg-paper">
      <div class="max-w-5xl mx-auto px-6">
        <span class="label-mono text-saffron mb-3 block">{formatDate(item.date)}</span>
        <h2 class="font-display text-2xl font-semibold text-ink mb-3">{item.title}</h2>
        <p class="text-ink-soft leading-relaxed max-w-3xl">{item.body}</p>
        {item.link && item.link !== '#' && (
          <a href={item.link} target="_blank" rel="noopener" class="inline-block mt-3 text-sm link-ink text-saffron hover:text-saffron-bright transition-colors">Read more →</a>
        )}
      </div>
    </article>
  ))}

  <CTABand
    heading="Working on something similar?"
    sub="I would rather hear about your problem than keep talking about mine."
  />
</Base>
